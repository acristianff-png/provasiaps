  function tipoLabel(t){ return t === 'discursiva' ? 'Discursiva' : 'Objetiva'; }

  function filteredQuestoes(){
    const busca = $('#fBusca').value.trim().toLowerCase();
    const tema = $('#fTema').value;
    const tipo = $('#fTipo').value;
    const dif = $('#fDificuldade').value;
    const elab = $('#fElaborador').value;
    const sit = $('#fSituacao').value;
    return questoes.filter(q=>{
      if(busca && !((q.enunciado||'').toLowerCase().includes(busca))) return false;
      if(tema && (q.tema||'').trim().toLowerCase() !== tema.trim().toLowerCase()) return false;
      if(tipo && (q.tipo||'objetiva') !== tipo) return false;
      if(dif === '__vazia' && q.dificuldade) return false;
      if(dif && dif !== '__vazia' && q.dificuldade !== dif) return false;
      if(elab && (q.elaboradoPor||'').trim().toLowerCase() !== elab.trim().toLowerCase()) return false;
      if(sit === 'revisar' && !q.precisaRevisao) return false;
      if(sit === 'usada' && !q.usadoAnteriormente) return false;
      if(sit === 'nunca-usada' && q.usadoAnteriormente) return false;
      return true;
    }).sort((a,b)=> (a.tema||'').localeCompare(b.tema||'','pt-BR'));
  }

  function renderBancoTable(){
    const list = filteredQuestoes();
    const tbody = $('#bancoTbody');
    $('#bancoEmpty').style.display = list.length ? 'none' : 'block';
    tbody.innerHTML = list.map(q=>{
      const enunPreview = (q.enunciado||'').slice(0,140).replace(/\n/g,' ');
      const difBadge = q.dificuldade ? `<span class="badge ${q.dificuldade}">${dificuldadeLabel(q.dificuldade)}</span>` : `<span class="badge neutro">—</span>`;
      const tipoBadge = `<span class="pill">${tipoLabel(q.tipo)}</span>`;
      const situacao = q.precisaRevisao
        ? `<span class="badge outline">precisa revisão</span>`
        : `<span class="pill">ok</span>`;
      return `<tr>
        <td>${escapeHtml(enunPreview)}${(q.enunciado||'').length>140?'…':''}</td>
        <td>${escapeHtml(q.tema||'')}</td>
        <td>${tipoBadge}</td>
        <td>${difBadge}</td>
        <td>${escapeHtml(q.elaboradoPor||'')}</td>
        <td>${q.origem==='importado' ? `<span class="pill">importada${q.provaOrigem?': '+escapeHtml(q.provaOrigem):''}</span>` : '<span class="pill">manual</span>'}</td>
