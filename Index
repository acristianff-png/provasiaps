  // ---------- db init (Supabase) ----------
  async function carregarQuestoes(){
    const { data, error } = await sb.from('iaps1_questoes').select('*').order('criadoEm', { ascending: true });
    if(error){ $('#connStatus').textContent = 'erro ao sincronizar: ' + error.message; return; }
    questoes = data || [];
    dbReady = true;
    $('#connStatus').textContent = 'sincronizado · ' + questoes.length + ' questões no banco';
    renderAll();
