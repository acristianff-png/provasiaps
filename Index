<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Banco de Questões — IAPS I</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --bg:#f4f5f7; --surface:#ffffff; --surface-2:#eef0f4; --border:#dde1e8;
    --text:#161922; --text-dim:#6b7280; --accent:#2f5fff; --accent-2:#5478ff;
    --ok:#1a8f5c; --warn:#b4650f; --danger:#c43b3b; --radius:12px;
    --shadow:0 1px 2px rgba(22,25,34,.05), 0 1px 10px rgba(22,25,34,.04);
    --facil:#1a8f5c; --medio:#b4650f; --dificil:#c43b3b;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#111319; --surface:#191c24; --surface-2:#20242e; --border:#2b3040;
      --text:#eceef3; --text-dim:#9aa1b2; --accent:#7c96ff; --accent-2:#9db0ff;
      --ok:#3fcf8e; --warn:#e0a855; --danger:#ef6f6f;
    }
  }
  :root[data-theme="dark"]{
    --bg:#111319; --surface:#191c24; --surface-2:#20242e; --border:#2b3040;
    --text:#eceef3; --text-dim:#9aa1b2; --accent:#7c96ff; --accent-2:#9db0ff;
    --ok:#3fcf8e; --warn:#e0a855; --danger:#ef6f6f;
  }
  *{box-sizing:border-box}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:"Manrope", -apple-system, "Segoe UI", sans-serif;
    font-size:15px; line-height:1.5; letter-spacing:-0.005em;
  }
  a{color:var(--accent-2)}
  header.app{
    padding:18px 24px; border-bottom:1px solid var(--border); background:var(--surface);
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;
    position:sticky; top:0; z-index:20;
  }
  header.app h1{ font-family:"Source Serif 4", Georgia, serif; font-size:21px; margin:0; font-weight:600; letter-spacing:0; }
  header.app .sub{ color:var(--text-dim); font-size:13px; }
  nav.tabs{ display:flex; gap:4px; padding:0 24px; background:var(--surface); border-bottom:1px solid var(--border); overflow-x:auto; }
  nav.tabs button{
    background:none; border:none; padding:12px 14px; font-size:14px; color:var(--text-dim);
    cursor:pointer; border-bottom:2px solid transparent; white-space:nowrap; font-weight:600;
  }
  nav.tabs button.active{ color:var(--accent); border-bottom-color:var(--accent); }
  main{ max-width:1180px; margin:0 auto; padding:22px 24px 60px; }
  h2{ font-family:"Source Serif 4", Georgia, serif; font-weight:600; letter-spacing:0; }
  .card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px; box-shadow:var(--shadow); margin-bottom:16px; }
  .row{ display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; }
  .field{ display:flex; flex-direction:column; gap:4px; min-width:160px; }
  .field.grow{ flex:1; }
  label{ font-size:12.5px; color:var(--text-dim); font-weight:600; }
  input[type=text], input[type=number], input[type=search], select, textarea{
    background:var(--surface-2); border:1px solid var(--border); border-radius:7px; color:var(--text);
    padding:8px 10px; font-size:14px; font-family:inherit;
  }
  textarea{ resize:vertical; min-height:70px; }
  input:focus, select:focus, textarea:focus{ outline:2px solid var(--accent-2); outline-offset:0; }
  button{ font-family:inherit; cursor:pointer; }
  .btn{ background:var(--accent); color:#fff; border:none; border-radius:7px; padding:9px 16px; font-size:14px; font-weight:600; }
  .btn:hover{ background:var(--accent-2); }
  .btn.secondary{ background:var(--surface-2); color:var(--text); border:1px solid var(--border); }
  .btn.secondary:hover{ background:var(--border); }
  .btn.danger{ background:transparent; color:var(--danger); border:1px solid var(--danger); }
  .btn.danger:hover{ background:var(--danger); color:#fff; }
  .btn.small{ padding:5px 10px; font-size:12.5px; }
  .btn:disabled{ opacity:.5; cursor:not-allowed; }
  .row-actions{ display:flex; flex-wrap:nowrap; gap:6px; align-items:center; justify-content:flex-end; }
  .icon-btn{
    width:30px; height:30px; flex:0 0 auto; display:inline-flex; align-items:center; justify-content:center;
    background:var(--surface-2); border:1px solid var(--border); border-radius:7px; font-size:14px;
    cursor:pointer; line-height:1; padding:0;
  }
  .icon-btn:hover{ background:var(--border); }
  .icon-btn.danger:hover{ background:var(--danger); filter:brightness(1); }
  .icon-btn.danger{ border-color:var(--danger); }
  table{ width:100%; border-collapse:collapse; font-size:13.5px; }
  th, td{ text-align:left; padding:8px 8px; border-bottom:1px solid var(--border); vertical-align:top; }
  th{ color:var(--text-dim); font-size:12px; text-transform:uppercase; letter-spacing:.03em; position:sticky; top:0; background:var(--surface); }
  tr:hover td{ background:var(--surface-2); }
  .table-wrap{ overflow-x:auto; }
  .badge{ display:inline-block; padding:2px 8px; border-radius:20px; font-size:11.5px; font-weight:700; color:#fff; }
  .badge.facil{ background:var(--facil); }
  .badge.medio{ background:var(--medio); }
  .badge.dificil{ background:var(--dificil); }
  .badge.neutro{ background:var(--text-dim); }
  .badge.outline{ background:transparent; border:1px solid var(--warn); color:var(--warn); }
  .pill{ display:inline-block; padding:1px 8px; border-radius:20px; font-size:11.5px; background:var(--surface-2); border:1px solid var(--border); color:var(--text-dim); }
  .muted{ color:var(--text-dim); }
  .stat-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; }
  .stat{ background:var(--surface-2); border:1px solid var(--border); border-radius:9px; padding:12px 14px; }
  .stat .num{ font-size:24px; font-weight:800; color:var(--accent); }
  .stat .lbl{ font-size:12px; color:var(--text-dim); }
  .alt-row{ display:flex; align-items:flex-start; gap:8px; margin-bottom:6px; }
  .alt-row textarea{ flex:1; min-height:44px; }
  .alt-letter{ width:26px; height:26px; border-radius:50%; background:var(--surface-2); border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center; font-weight:700; font-size:12.5px; margin-top:6px; flex-shrink:0; }
  .modal-backdrop{ position:fixed; inset:0; background:rgba(0,0,0,.45); display:flex; align-items:flex-start; justify-content:center;
    padding:30px 16px; overflow-y:auto; z-index:100; }
  .modal{ background:var(--surface); border-radius:var(--radius); border:1px solid var(--border); max-width:720px; width:100%; padding:22px; }
  .modal h2{ margin-top:0; font-size:17px; }
  .close-x{ float:right; background:none; border:none; font-size:20px; color:var(--text-dim); line-height:1; }
  .toast{ position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:var(--accent); color:#fff;
    padding:10px 18px; border-radius:8px; font-size:13.5px; z-index:200; box-shadow:var(--shadow); opacity:0; transition:opacity .25s; pointer-events:none; }
  .toast.show{ opacity:1; }
  .empty{ text-align:center; padding:40px 20px; color:var(--text-dim); }
  .flex-between{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; }
  .q-preview{ border:1px solid var(--border); border-radius:8px; padding:12px 14px; margin-bottom:10px; background:var(--surface-2); }
  .q-preview .meta{ font-size:11.5px; color:var(--text-dim); margin-bottom:6px; }
  .q-preview .enun{ white-space:pre-wrap; margin-bottom:8px; }
  .q-preview .alt{ padding:2px 0; white-space:pre-wrap; }
  .q-preview .alt.correct{ color:var(--ok); font-weight:700; }
  .print-area{ display:none; }
  .checklist{ display:flex; flex-wrap:wrap; gap:6px; max-height:150px; overflow-y:auto; border:1px solid var(--border);
    border-radius:8px; padding:8px; background:var(--surface-2); }
  .checklist label{ display:flex; align-items:center; gap:5px; font-weight:400; color:var(--text); background:var(--surface);
    border:1px solid var(--border); padding:3px 8px; border-radius:20px; font-size:12.5px; cursor:pointer; }
  .checklist input{ margin:0; }
  .save-status{ font-size:12px; color:var(--text-dim); }
  .divider{ border:none; border-top:1px solid var(--border); margin:14px 0; }
  .revisao-tag{ color:var(--warn); font-size:12px; }
  select[multiple]{ min-height:90px; }
  @media print{
    body *{ visibility:hidden; }
    .print-area, .print-area *{ visibility:visible; }
    .print-area{ display:block; position:absolute; top:0; left:0; width:100%; padding:0; }
    .no-print{ display:none !important; }
    .page-break{ page-break-after:always; break-after:page; }
    .page-break-before{ page-break-before:always; break-before:page; }
  }
</style>
</head>
<body>

<header class="app">
  <div>
    <h1>📋 Banco de Questões — IAPS I</h1>
    <div class="sub">Iniciação à Atenção Primária à Saúde I · cadastro colaborativo e geração de provas</div>
  </div>
  <div class="save-status" id="connStatus">conectando…</div>
</header>

<nav class="tabs no-print">
  <button data-tab="banco" class="active">Banco de questões</button>
  <button data-tab="nova">Nova questão</button>
  <button data-tab="gerar">Gerar prova</button>
  <button data-tab="provas">Provas geradas</button>
</nav>

<main>

  <!-- ===================== TAB: BANCO ===================== -->
  <section id="tab-banco">
    <div class="card">
      <div class="flex-between">
        <div class="stat-grid" id="statGrid" style="flex:1"></div>
        <div style="margin-left:14px;white-space:nowrap;display:flex;flex-direction:column;gap:6px;align-items:flex-end">
          <label class="btn secondary small" for="inputImportarJSON" style="cursor:pointer">⬆️ Importar backup (.json)</label>
          <input type="file" id="inputImportarJSON" accept=".json" style="display:none" />
        </div>
      </div>
      <p class="muted" style="font-size:12px;margin:8px 0 0">Importa (ou reimporta) um backup gerado pelo botão "Exportar tudo" do sistema anterior. Questões com o mesmo <code>idOriginal</code> são atualizadas, não duplicadas.</p>
    </div>

    <div class="card">
      <div class="row">
        <div class="field grow">
          <label>Buscar no enunciado</label>
          <input type="search" id="fBusca" placeholder="digite para buscar…" />
        </div>
        <div class="field">
          <label>Tema</label>
          <select id="fTema"><option value="">Todos</option></select>
        </div>
        <div class="field">
          <label>Tipo</label>
          <select id="fTipo">
            <option value="">Todos</option>
            <option value="objetiva">Objetiva</option>
            <option value="discursiva">Discursiva</option>
          </select>
        </div>
        <div class="field">
          <label>Dificuldade</label>
          <select id="fDificuldade">
            <option value="">Todas</option>
            <option value="facil">Fácil</option>
            <option value="medio">Médio</option>
            <option value="dificil">Difícil</option>
            <option value="">-</option>
            <option value="__vazia">Sem dificuldade definida</option>
          </select>
        </div>
        <div class="field">
          <label>Elaborador(a)</label>
          <select id="fElaborador"><option value="">Todos</option></select>
        </div>
        <div class="field">
          <label>Situação</label>
          <select id="fSituacao">
            <option value="">Todas</option>
            <option value="revisar">Precisa revisão</option>
            <option value="usada">Já usada em prova</option>
            <option value="nunca-usada">Nunca usada</option>
          </select>
        </div>
        <div class="field">
          <button class="btn secondary" id="btnLimparFiltros">Limpar filtros</button>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:24%">Enunciado</th>
              <th>Tema</th>
              <th>Tipo</th>
              <th>Dificuldade</th>
              <th>Elaborador(a)</th>
              <th>Origem</th>
              <th>Usada?</th>
              <th>Situação</th>
              <th style="width:110px"></th>
            </tr>
          </thead>
          <tbody id="bancoTbody"></tbody>
        </table>
        <div class="empty" id="bancoEmpty" style="display:none">Nenhuma questão encontrada com esses filtros.</div>
      </div>
    </div>
  </section>

  <!-- ===================== TAB: NOVA/EDITAR ===================== -->
  <section id="tab-nova" style="display:none">
    <div class="card">
      <h2 id="formTitulo" style="margin-top:0">Nova questão</h2>
      <input type="hidden" id="editId" value="" />
      <div class="row">
        <div class="field grow">
          <label>Tema *</label>
          <input type="text" id="qTema" list="temaOptions" placeholder="ex: Gênero, Racismo, Vulnerabilidade..." />
          <datalist id="temaOptions"></datalist>
        </div>
        <div class="field">
          <label>Tipo *</label>
          <select id="qTipo">
            <option value="objetiva">Objetiva (múltipla escolha)</option>
            <option value="discursiva">Discursiva (aberta)</option>
          </select>
        </div>
        <div class="field">
          <label>Dificuldade *</label>
          <select id="qDificuldade">
            <option value="">Selecione…</option>
            <option value="facil">Fácil</option>
            <option value="medio">Médio</option>
            <option value="dificil">Difícil</option>
          </select>
        </div>
        <div class="field">
          <label>Elaborado por</label>
          <input type="text" id="qElaborador" placeholder="seu nome" />
        </div>
      </div>

      <div class="field" style="margin-top:12px">
        <label>Enunciado da questão *</label>
        <textarea id="qEnunciado" style="min-height:120px" placeholder="Cole ou digite o enunciado completo (pode incluir trechos de leitura, casos clínicos, tabelas em texto, etc.)"></textarea>
      </div>

      <div id="blocoAlternativas" style="margin-top:14px">
        <div class="flex-between">
          <label style="margin:0">Alternativas * <span class="muted" style="font-weight:400">(marque a correta — a letra final é definida automaticamente ao gerar a prova, então a ordem aqui não importa)</span></label>
          <button class="btn secondary small" id="btnAddAlt" type="button">+ alternativa</button>
        </div>
        <div id="altList" style="margin-top:8px"></div>
      </div>

      <div class="row" style="margin-top:14px">
        <div class="field grow">
          <label id="lblDiscussao">Discussão / resolução comentada</label>
          <textarea id="qDiscussao" placeholder="Explique por que a alternativa correta está certa e, se útil, por que as demais estão erradas."></textarea>
        </div>
        <div class="field grow">
          <label>Referência utilizada</label>
          <textarea id="qReferencia" placeholder="Referência bibliográfica usada para elaborar a questão"></textarea>
        </div>
      </div>

      <div class="row" style="margin-top:6px">
        <div class="field">
          <label style="display:flex;align-items:center;gap:6px;font-weight:400">
            <input type="checkbox" id="qPrecisaRevisao" style="width:auto" /> marcar como "precisa revisão" (não entrará em provas geradas até ser revisada)
          </label>
        </div>
      </div>

      <div class="row" style="margin-top:16px">
        <button class="btn" id="btnSalvarQuestao">Salvar questão</button>
        <button class="btn secondary" id="btnCancelarEdicao" style="display:none">Cancelar edição</button>
        <span id="formMsg" class="muted"></span>
      </div>
    </div>
  </section>

  <!-- ===================== TAB: GERAR PROVA ===================== -->
  <section id="tab-gerar" style="display:none">
    <div class="card">
      <h2 style="margin-top:0">Configurar nova prova</h2>
      <div class="row">
        <div class="field grow">
          <label>Título da prova</label>
          <input type="text" id="gTitulo" placeholder="ex: Prova II — CSAS" />
        </div>
        <div class="field">
          <label>Semestre / identificação (Turma)</label>
          <input type="text" id="gSemestre" placeholder="ex: 2026.2" />
        </div>
      </div>

      <div class="row" style="margin-top:10px">
        <div class="field grow">
          <label>Professor(a)</label>
          <input type="text" id="gProfessora" placeholder="ex: Profa. Elis..." />
        </div>
        <div class="field">
          <label>Valor da prova (pontos)</label>
          <input type="text" id="gValor" placeholder="ex: 30 pontos" style="width:140px" />
        </div>
        <div class="field">
          <label>Duração</label>
          <input type="text" id="gDuracao" placeholder="ex: 2 (duas) horas" style="width:160px" />
        </div>
      </div>
      <p class="muted" style="margin:8px 0 0;font-size:12.5px">Esses dados preenchem o cabeçalho oficial (capa + gabarito) quando a prova é impressa/baixada. Departamento, Faculdade e disciplina seguem fixos no modelo da UFMG/IAPS I.</p>

      <hr class="divider" />

      <p style="font-weight:700;margin:0 0 6px">Parte I — questões objetivas</p>
      <div class="row">
        <div class="field">
          <label>Questões fáceis</label>
          <input type="number" id="gFacil" min="0" value="0" style="width:100px" />
        </div>
        <div class="field">
          <label>Questões médias</label>
          <input type="number" id="gMedio" min="0" value="0" style="width:100px" />
        </div>
        <div class="field">
          <label>Questões difíceis</label>
          <input type="number" id="gDificil" min="0" value="0" style="width:100px" />
        </div>
      </div>

      <p style="font-weight:700;margin:16px 0 6px">Parte II — questões discursivas (opcional)</p>
      <div class="row">
        <div class="field">
          <label>Questões fáceis</label>
          <input type="number" id="gFacilD" min="0" value="0" style="width:100px" />
        </div>
        <div class="field">
          <label>Questões médias</label>
          <input type="number" id="gMedioD" min="0" value="0" style="width:100px" />
        </div>
        <div class="field">
          <label>Questões difíceis</label>
          <input type="number" id="gDificilD" min="0" value="0" style="width:100px" />
        </div>
      </div>

      <div class="field" style="margin-top:12px">
        <label>Restringir a temas específicos (opcional — deixe tudo desmarcado para usar qualquer tema)</label>
        <div class="checklist" id="gTemasChecklist"></div>
      </div>

      <div class="row" style="margin-top:12px">
        <div class="field">
          <label style="display:flex;align-items:center;gap:6px;font-weight:400">
            <input type="checkbox" id="gPriorizarNaoUsadas" checked style="width:auto" /> priorizar questões ainda não usadas
          </label>
        </div>
      </div>

      <div class="row" style="margin-top:16px">
        <button class="btn" id="btnGerarRascunho">🎲 Gerar rascunho</button>
        <span id="gerarMsg" class="muted"></span>
      </div>
    </div>

    <div class="card" id="rascunhoCard" style="display:none">
      <div class="flex-between">
        <h2 style="margin:0">Prévia da prova</h2>
        <div>
          <button class="btn secondary small" id="btnReshuffle">🔀 Sortear novamente</button>
        </div>
      </div>
      <p class="muted" id="rascunhoResumo"></p>
      <div id="rascunhoLista"></div>
      <div class="row" style="margin-top:14px">
        <button class="btn" id="btnSalvarProva">✅ Salvar e finalizar prova</button>
        <span id="salvarProvaMsg" class="muted"></span>
      </div>
    </div>
  </section>

  <!-- ===================== TAB: PROVAS GERADAS ===================== -->
  <section id="tab-provas" style="display:none">
    <div class="card">
      <h2 style="margin-top:0">Provas geradas anteriormente</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Título</th><th>Semestre</th><th>Data</th><th>Nº questões</th><th></th></tr></thead>
          <tbody id="provasTbody"></tbody>
        </table>
        <div class="empty" id="provasEmpty" style="display:none">Nenhuma prova gerada ainda.</div>
      </div>
    </div>

    <div class="card" id="viewProvaCard" style="display:none">
      <div class="flex-between no-print">
        <h2 style="margin:0" id="viewProvaTitulo"></h2>
        <div>
          <button class="btn secondary small" id="btnMostrarProva">Ver prova (sem gabarito)</button>
          <button class="btn secondary small" id="btnMostrarGabarito">Ver gabarito</button>
          <button class="btn secondary small" id="btnImprimir">🖨️ Imprimir</button>
          <button class="btn small" id="btnBaixar">⬇️ Baixar (arquivo para imprimir)</button>
        </div>
      </div>
      <div id="viewProvaConteudo" style="margin-top:14px"></div>
    </div>
  </section>

</main>

<div class="print-area" id="printArea"></div>

<div id="modalRoot"></div>
<div class="toast" id="toast"></div>

<script>
(function(){
  "use strict";

  // ---------- configuração Supabase ----------
  const SUPABASE_URL = 'https://cwstvgauueaxupdwomef.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_J3_hfUCVoikQT25v7IbGjQ_z9fUJxDq';
  const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  function uid(){
    return (crypto.randomUUID ? crypto.randomUUID() : 'id-' + Date.now() + '-' + Math.random().toString(16).slice(2));
  }

  // ---------- state ----------
  let db = true; // sempre "disponível" nesta versão (Supabase)
  let dbReady = false;
  let questoes = [];         // live array of {id, ...data}
  let provas = [];
  let editingAltCorrect = 0;
  let rascunho = null;       // draft exam before saving
  let viewMode = 'prova';    // 'prova' | 'gabarito'
  let currentViewProva = null;

  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => Array.from(document.querySelectorAll(sel));

  function toast(msg, ms){
    const t = $('#toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._timer);
    t._timer = setTimeout(()=> t.classList.remove('show'), ms||2400);
  }

  function escapeHtml(s){
    return (s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function nl2br(s){
    return escapeHtml(s||'').replace(/\n/g,'<br>');
  }

  function dificuldadeLabel(d){
    return d === 'facil' ? 'Fácil' : d === 'medio' ? 'Médio' : d === 'dificil' ? 'Difícil' : '—';
  }

  function shuffle(arr){
    const a = arr.slice();
    for(let i=a.length-1;i>0;i--){
      const j = Math.floor(Math.random()*(i+1));
      [a[i],a[j]]=[a[j],a[i]];
    }
    return a;
  }

  // ---------- tabs ----------
  $$('nav.tabs button').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      $$('nav.tabs button').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
