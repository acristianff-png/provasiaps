  // ---------- gerar prova ----------
  function renderTemasChecklist(){
    const temas = uniqueSorted(questoes.map(q=>q.tema));
    const box = $('#gTemasChecklist');
    const checked = new Set(Array.from(box.querySelectorAll('input:checked')).map(i=>i.value));
    box.innerHTML = temas.map(t=>`<label><input type="checkbox" value="${escapeHtml(t)}" ${checked.has(t)?'checked':''}/> ${escapeHtml(t)}</label>`).join('') || '<span class="muted">nenhum tema cadastrado ainda</span>';
  }

  function pickQuestions(tipo, dificuldade, qtd, temasFiltro, priorizarNaoUsadas, exclude){
    let pool = questoes.filter(q=>
      !q.precisaRevisao &&
      (q.tipo||'objetiva') === tipo &&
      q.dificuldade === dificuldade &&
      (tipo==='discursiva' ? !!(q.discussao && q.discussao.trim()) : (q.corretaIndex !== null && q.corretaIndex !== undefined && (q.alternativas||[]).length >= 2)) &&
      !exclude.has(q.id) &&
      (temasFiltro.length === 0 || temasFiltro.some(t=> (q.tema||'').trim().toLowerCase() === t.trim().toLowerCase()))
    );
    if(priorizarNaoUsadas){
      const naoUsadas = shuffle(pool.filter(q=>!q.usadoAnteriormente));
      const usadas = shuffle(pool.filter(q=>q.usadoAnteriormente));
      pool = naoUsadas.concat(usadas);
    } else {
      pool = shuffle(pool);
    }
    return pool.slice(0, qtd);
  }

  function montarParte(tipo, contagens, temasFiltro, priorizarNaoUsadas, exclude){
    const picked = [];
    [['facil',contagens.facil],['medio',contagens.medio],['dificil',contagens.dificil]].forEach(([nivel,qtd])=>{
      if(qtd<=0) return;
      const sel = pickQuestions(tipo, nivel, qtd, temasFiltro, priorizarNaoUsadas, exclude);
      sel.forEach(q=> exclude.add(q.id));
      picked.push({nivel, qtd, encontradas: sel.length, questoes: sel});
    });
    const faltando = picked.filter(p=>p.encontradas < p.qtd);
    const lista = picked.flatMap(p=>p.questoes).map(q=>{
      let alternativas = [], corretaIndex = null;
      if(tipo === 'objetiva'){
        const order = shuffle(q.alternativas.map((texto,i)=>({texto, original: i})));
        corretaIndex = order.findIndex(o=>o.original === q.corretaIndex);
        alternativas = order.map(o=>o.texto);
      }
      return {
        questaoId: q.id, tipo,
        tema: q.tema, dificuldade: q.dificuldade,
        enunciado: q.enunciado,
        alternativas, corretaIndex,
        discussao: q.discussao||'', referencia: q.referencia||'',
        elaboradoPor: q.elaboradoPor||''
      };
    });
    return { lista: shuffle(lista), faltando };
  }

  function buildRascunho(){
    const contagensObj = {
      facil: parseInt($('#gFacil').value)||0,
      medio: parseInt($('#gMedio').value)||0,
      dificil: parseInt($('#gDificil').value)||0
    };
    const contagensDisc = {
      facil: parseInt($('#gFacilD').value)||0,
      medio: parseInt($('#gMedioD').value)||0,
      dificil: parseInt($('#gDificilD').value)||0
    };
    const temasFiltro = Array.from($('#gTemasChecklist').querySelectorAll('input:checked')).map(i=>i.value);
    const priorizarNaoUsadas = $('#gPriorizarNaoUsadas').checked;
    const totalObj = contagensObj.facil+contagensObj.medio+contagensObj.dificil;
    const totalDisc = contagensDisc.facil+contagensDisc.medio+contagensDisc.dificil;

    if(totalObj + totalDisc === 0){
      $('#gerarMsg').textContent = 'Informe ao menos 1 questão (objetiva ou discursiva).';
      $('#gerarMsg').style.color = 'var(--danger)';
      return null;
    }

    const exclude = new Set();
    const parteI = montarParte('objetiva', contagensObj, temasFiltro, priorizarNaoUsadas, exclude);
    const parteII = montarParte('discursiva', contagensDisc, temasFiltro, priorizarNaoUsadas, exclude);

    const faltando = [...parteI.faltando, ...parteII.faltando];
    let avisoTexto = '';
    if(faltando.length){
      avisoTexto = 'Atenção: não há questões suficientes para ' +
        faltando.map(f=>`${dificuldadeLabel(f.nivel)} (pedidas ${f.qtd}, encontradas ${f.encontradas})`).join('; ') +
        (temasFiltro.length ? ' considerando os temas selecionados.' : '.');
    }

    parteI.lista.forEach((q,i)=> q.numero = i+1);
    parteII.lista.forEach((q,i)=> q.numero = i+1);

    return {
      titulo: $('#gTitulo').value.trim() || 'Prova sem título',
      semestre: $('#gSemestre').value.trim(),
      professora: $('#gProfessora').value.trim(),
      valor: $('#gValor').value.trim(),
      duracao: $('#gDuracao').value.trim(),
      temasFiltro, priorizarNaoUsadas,
      contagens: contagensObj,
      contagensDiscursiva: contagensDisc,
      questoes: parteI.lista,
      questoesDiscursivas: parteII.lista,
      aviso: avisoTexto
    };
  }

  $('#btnGerarRascunho').addEventListener('click', ()=>{
    $('#gerarMsg').textContent='';
    const r = buildRascunho();
    if(!r) return;
    rascunho = r;
    renderRascunho();
  });

  $('#btnReshuffle').addEventListener('click', ()=>{
    const r = buildRascunho();
    if(!r) return;
    rascunho = r;
    renderRascunho();
    toast('Nova seleção sorteada.');
  });

  function renderRascunho(){
    $('#rascunhoCard').style.display='block';
    const totalQ = rascunho.questoes.length + rascunho.questoesDiscursivas.length;
    $('#rascunhoResumo').innerHTML =
      `<strong>${totalQ}</strong> questões selecionadas — ` +
      `Parte I objetiva: ${rascunho.questoes.length} (fácil: ${rascunho.contagens.facil}, médio: ${rascunho.contagens.medio}, difícil: ${rascunho.contagens.dificil})` +
      (rascunho.questoesDiscursivas.length ? ` · Parte II discursiva: ${rascunho.questoesDiscursivas.length} (fácil: ${rascunho.contagensDiscursiva.facil}, médio: ${rascunho.contagensDiscursiva.medio}, difícil: ${rascunho.contagensDiscursiva.dificil})` : '') +
      (rascunho.temasFiltro.length ? ` · temas: ${rascunho.temasFiltro.join(', ')}` : '') +
      (rascunho.aviso ? `<br><span style="color:var(--warn)">⚠️ ${escapeHtml(rascunho.aviso)}</span>` : '');

    function renderQ(q, i, prefixo){
      const alts = (q.alternativas||[]).map((a,j)=>{
        const letra = String.fromCharCode(97+j);
        const correta = j === q.corretaIndex;
        return `<div class="alt ${correta?'correct':''}">${letra}) ${nl2br(a)}${correta?' ✓':''}</div>`;
      }).join('');
      return `<div class="q-preview">
        <div class="meta">${prefixo}${i+1}. ${escapeHtml(q.tema)} · <span class="badge ${q.dificuldade}">${dificuldadeLabel(q.dificuldade)}</span></div>
        <div class="enun">${nl2br(q.enunciado)}</div>
        ${alts}
      </div>`;
    }

    let html = '';
    if(rascunho.questoes.length){
      html += '<p style="font-weight:700">Parte I — objetiva</p>';
      html += rascunho.questoes.map((q,i)=> renderQ(q,i,'')).join('');
    }
    if(rascunho.questoesDiscursivas.length){
      html += '<p style="font-weight:700;margin-top:14px">Parte II — discursiva</p>';
      html += rascunho.questoesDiscursivas.map((q,i)=> renderQ(q,i,'')).join('');
    }
    $('#rascunhoLista').innerHTML = html;
  }

  $('#btnSalvarProva').addEventListener('click', async ()=>{
    if(!rascunho) return;
    $('#salvarProvaMsg').textContent = 'salvando…';
    const now = new Date().toISOString();
    const provaId = uid();
    const { error: errProva } = await sb.from('iaps1_provas').insert({
      id: provaId,
      titulo: rascunho.titulo,
      semestre: rascunho.semestre,
      professora: rascunho.professora,
      valor: rascunho.valor,
      duracao: rascunho.duracao,
      criadoEm: now,
      contagens: rascunho.contagens,
      contagensDiscursiva: rascunho.contagensDiscursiva,
      temasFiltro: rascunho.temasFiltro,
      questoes: rascunho.questoes,
      questoesDiscursivas: rascunho.questoesDiscursivas
    });
    if(errProva){
      $('#salvarProvaMsg').textContent = 'Erro ao salvar: ' + errProva.message;
      return;
    }
    // marca cada questão usada (ambas as partes)
    for(const q of [...rascunho.questoes, ...rascunho.questoesDiscursivas]){
      const { data: atual } = await sb.from('iaps1_questoes').select('historicoUso').eq('id', q.questaoId).single();
      const hist = Array.isArray(atual && atual.historicoUso) ? atual.historicoUso.slice() : [];
      hist.push({provaTitulo: rascunho.titulo, provaId, data: now});
      await sb.from('iaps1_questoes').update({ usadoAnteriormente: true, historicoUso: hist }).eq('id', q.questaoId);
    }
    $('#salvarProvaMsg').textContent = '';
    toast('Prova salva com sucesso!');
    rascunho = null;
    $('#rascunhoCard').style.display='none';
    $('#gTitulo').value=''; $('#gSemestre').value=''; $('#gProfessora').value=''; $('#gValor').value=''; $('#gDuracao').value='';
    $('#gFacil').value=0; $('#gMedio').value=0; $('#gDificil').value=0;
    $('#gFacilD').value=0; $('#gMedioD').value=0; $('#gDificilD').value=0;
    $$('nav.tabs button').forEach(b=>b.classList.toggle('active', b.dataset.tab==='provas'));
    $$('main > section').forEach(s=> s.style.display='none');
    $('#tab-provas').style.display='block';
    carregarQuestoes(); carregarProvas();
  });

  // ---------- provas geradas ----------
  function renderProvasTable(){
    $('#provasEmpty').style.display = provas.length ? 'none' : 'block';
    $('#provasTbody').innerHTML = provas.map(p=>{
      const data = p.criadoEm ? new Date(p.criadoEm).toLocaleDateString('pt-BR') : '';
      const n = (p.questoes||[]).length + (p.questoesDiscursivas||[]).length;
      return `<tr>
        <td>${escapeHtml(p.titulo||'')}</td>
        <td>${escapeHtml(p.semestre||'')}</td>
        <td>${data}</td>
        <td>${n}</td>
        <td><button class="btn secondary small" data-id="${p.id}" data-act="abrir">abrir</button></td>
      </tr>`;
    }).join('');
    $('#provasTbody').querySelectorAll('[data-act="abrir"]').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const p = provas.find(x=>x.id===btn.dataset.id);
        openProvaView(p);
      });
    });
  }

  function openProvaView(p){
    currentViewProva = p;
    viewMode = 'prova';
    $('#viewProvaCard').style.display='block';
    $('#viewProvaTitulo').textContent = p.titulo + (p.semestre ? ' — '+p.semestre : '');
    renderProvaView();
    $('#viewProvaCard').scrollIntoView({behavior:'smooth'});
  }

  $('#btnMostrarProva').addEventListener('click', ()=>{ viewMode='prova'; renderProvaView(); });
  $('#btnMostrarGabarito').addEventListener('click', ()=>{ viewMode='gabarito'; renderProvaView(); });
  $('#btnImprimir').addEventListener('click', ()=>{
    try{
      $('#printArea').innerHTML = $('#viewProvaConteudo').innerHTML;
      window.print();
    }catch(e){
      toast('Não foi possível abrir a impressão aqui — use o botão "Baixar" para abrir o arquivo e imprimir de lá.');
    }
  });

  // download simples via Blob — funciona em qualquer navegador fora do sandbox do Claude
  function baixarArquivo(filename, content, mime){
    const blob = new Blob([content], {type: mime || 'text/plain'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(()=> URL.revokeObjectURL(url), 2000);
  }

  $('#inputImportarJSON').addEventListener('change', async (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    try{
      const texto = await file.text();
      const payload = JSON.parse(texto);
      const lista = Array.isArray(payload) ? payload : (payload.questoes || []);
      if(!lista.length){ toast('Arquivo sem questões reconhecíveis.'); return; }

      // evita duplicar: casa pelo idOriginal (ou pelo id, se o backup não tiver idOriginal)
      const { data: existentes } = await sb.from('iaps1_questoes').select('id, idOriginal');
      const porOriginal = new Map((existentes||[]).filter(q=>q.idOriginal).map(q=>[q.idOriginal, q.id]));

      const paraInserir = [];
      const paraAtualizar = [];
      lista.forEach(q=>{
        const idOriginal = q.idOriginal || q.id || null;
        const linha = Object.assign({}, q);
        delete linha.id;
        linha.idOriginal = idOriginal;
        if(idOriginal && porOriginal.has(idOriginal)){
          paraAtualizar.push(Object.assign({ id: porOriginal.get(idOriginal) }, linha));
        } else {
          linha.id = uid();
          paraInserir.push(linha);
        }
      });

      if(paraInserir.length){
        const { error } = await sb.from('iaps1_questoes').insert(paraInserir);
        if(error){ toast('Erro ao importar: ' + error.message); return; }
      }
      for(const row of paraAtualizar){
        const { id, ...resto } = row;
        await sb.from('iaps1_questoes').update(resto).eq('id', id);
      }
      toast(`Importação concluída: ${paraInserir.length} novas, ${paraAtualizar.length} atualizadas.`);
      carregarQuestoes();
    }catch(err){
      toast('Erro ao ler o arquivo: ' + (err && err.message || err));
    } finally {
      e.target.value = '';
    }
  });

  $('#btnBaixar').addEventListener('click', ()=>{
    if(!currentViewProva){ toast('Abra uma prova primeiro.'); return; }
    const p = currentViewProva;
    const conteudo = $('#viewProvaConteudo').innerHTML;
    const titulo = escapeHtml(p.titulo||'Prova') + (viewMode==='gabarito' ? ' - Gabarito' : '');
    const html = `<!doctype html>
<html lang="pt-BR"><head><meta charset="UTF-8">
<title>${titulo}</title>
<style>
  body{ font-family: Georgia, 'Times New Roman', serif; color:#111; max-width:800px; margin:30px auto; padding:0 20px; line-height:1.5; }
  .alt{ padding:2px 0; }
  .alt.correct{ color:#15803d; font-weight:700; }
  table{ border-collapse:collapse; }
  @media print{ body{ margin:0; padding:14px; } }
</style>
</head><body>${conteudo}
<script>
  window.addEventListener('load', ()=> setTimeout(()=> window.print(), 300));
<\/script>
</body></html>`;
    const nomeArquivo = (p.titulo||'prova').replace(/[^\w\-]+/g,'_') + (viewMode==='gabarito'?'_gabarito':'') + '.html';
    baixarArquivo(nomeArquivo, html, 'text/html');
    toast('Arquivo baixado — abra-o e use Ctrl+P / Cmd+P para salvar como PDF.');
  });

  function buildCapaHtml(p){
    const nObj = (p.questoes||[]).length;
    const nDisc = (p.questoesDiscursivas||[]).length;
    const maxAlts = Math.max(4, ...(p.questoes||[]).map(q=>(q.alternativas||[]).length));
    const letras = Array.from({length:maxAlts}, (_,i)=> String.fromCharCode(65+i));
    const valor = p.valor || '— pontos';
    const duracao = p.duracao || '— horas';
    const gabaritoRows = Array.from({length:nObj}, (_,i)=> `
      <tr>
        <td style="border:1px solid #333;padding:4px 8px;text-align:center;font-family:Georgia,serif">${i+1}</td>
        ${letras.map(l=>`<td style="border:1px solid #333;padding:4px 8px;text-align:center;font-family:Georgia,serif">${l}</td>`).join('')}
      </tr>`).join('');

    const composicaoTexto = nDisc > 0
      ? `Esta prova é composta por duas partes: <strong>Parte I – prova objetiva, com ${nObj} (${nObj===1?'uma':nObj}) questões de múltipla escolha</strong>; <strong>Parte II – prova discursiva, com ${nDisc} (${nDisc===1?'uma':nDisc}) questões abertas</strong>.`
      : `Esta prova é composta por <strong>${nObj} (${nObj===1?'uma':nObj}) questões de múltipla escolha</strong>.`;

    return `
    <div class="page-break" style="font-family:Georgia,'Times New Roman',serif;color:#111;font-size:13px;line-height:1.45;">
      <table style="width:100%;border-collapse:collapse;margin-bottom:10px">
        <tr>
          <td style="width:70%;text-align:center;vertical-align:middle;border-bottom:2px solid #111;padding-bottom:8px">
            <div style="font-size:14px">Universidade Federal de Minas Gerais</div>
            <div style="font-size:14px">Faculdade de Medicina</div>
            <div style="font-size:14px">Departamento de Medicina Preventiva e Social</div>
            <div style="font-size:14px;font-weight:bold">Disciplina de Iniciação à Atenção Primária à Saúde I — IAPS I</div>
          </td>
        </tr>
      </table>
      <table style="width:100%;border-collapse:collapse;margin-bottom:0;border:1px solid #333">
        <tr>
          <td style="border:1px solid #333;padding:5px 8px;width:50%">Professor(a): ${escapeHtml(p.professora||'')}</td>
          <td style="border:1px solid #333;padding:5px 8px">Turma: ${escapeHtml(p.semestre||'')}</td>
        </tr>
        <tr><td colspan="2" style="border:1px solid #333;padding:5px 8px">Nome: </td></tr>
        <tr>
          <td style="border:1px solid #333;padding:5px 8px">Matrícula: </td>
          <td style="border:1px solid #333;padding:0">
            <table style="width:100%;border-collapse:collapse"><tr>
              <td style="border-left:1px solid #333;padding:5px 8px;width:60%">Valor: ${escapeHtml(valor)}</td>
              <td style="border-left:1px solid #333;padding:5px 8px">Nota:</td>
            </tr></table>
          </td>
        </tr>
      </table>

      <div style="text-align:center;font-weight:bold;text-decoration:underline;margin:18px 0 10px">ORIENTAÇÕES</div>
      <p style="margin:0 0 10px">${composicaoTexto} A duração da prova é de <strong>${escapeHtml(duracao)}</strong>. Faça-a com tranquilidade, mas controle o seu tempo!</p>
      ${nObj > 0 ? `<p style="margin:0 0 10px">Para cada uma das questões da Parte I são apresentadas alternativas classificadas com as letras ${letras.join(', ')}, e só uma responde da melhor forma possível ao quesito proposto. Você só deve assinalar <strong>UMA RESPOSTA</strong> no <strong>GABARITO</strong>. A marcação de nenhuma ou de mais de uma alternativa anula a questão, <strong>MESMO QUE UMA DAS RESPOSTAS SEJA A CORRETA</strong>.</p>` : ''}
      ${nDisc > 0 ? `<p style="margin:0 0 10px">As questões discursivas da Parte II têm espaço próprio para escrita das respostas (favor não ultrapassar as linhas indicadas).</p>` : ''}
      <p style="margin:0 0 10px">O espaço da prova poderá ser utilizado para anotações, mas somente as respostas assinaladas no <strong>GABARITO</strong> (Parte I) e escritas no espaço próprio (Parte II) serão objeto de correção.</p>
      ${nObj > 0 ? `
      <p style="margin:0 0 10px">No <strong>GABARITO</strong> a seguir, para cada questão da Parte I assinale a opção correta:</p>
      <table style="border-collapse:collapse;margin:0 auto">
        <tr>
          <td style="border:1px solid #333;padding:4px 8px;text-align:center;font-weight:bold">QUESTÃO</td>
          <td colspan="${letras.length}" style="border:1px solid #333;padding:4px 8px;text-align:center;font-weight:bold">GABARITO</td>
        </tr>
        ${gabaritoRows}
      </table>` : ''}
    </div>`;
  }

  function renderProvaView(){
    const p = currentViewProva;
    if(!p) return;
    const capa = viewMode==='prova' ? buildCapaHtml(p) : '';
    const header = `<div style="border-bottom:2px solid #333;padding-bottom:10px;margin-bottom:16px;">
      <div style="font-size:17px;font-weight:700">${escapeHtml(p.titulo)}</div>
      <div class="muted">${escapeHtml(p.semestre||'')} ${viewMode==='gabarito' ? ' · GABARITO (uso do professor)' : ''}</div>
      ${viewMode==='prova' ? `<div style="margin-top:10px">Nome: _______________________________________________ &nbsp;&nbsp; Matrícula: ______________</div>` : ''}
    </div>`;

    function renderObjetiva(q, i){
      const alts = q.alternativas.map((a,j)=>{
        const letra = String.fromCharCode(97+j);
        const correta = j===q.corretaIndex;
        return `<div class="alt ${viewMode==='gabarito' && correta ? 'correct':''}" style="margin-left:14px">${letra}) ${nl2br(a)}</div>`;
      }).join('');
      const extra = viewMode==='gabarito' ? `
        ${q.discussao ? `<div style="margin-top:6px"><em>Discussão:</em> ${nl2br(q.discussao)}</div>` : ''}
        ${q.referencia ? `<div><em>Referência:</em> ${nl2br(q.referencia)}</div>` : ''}
      ` : '';
      return `<div style="margin-bottom:18px">
        <div><strong>${i+1}.</strong> ${nl2br(q.enunciado)}</div>
        ${alts}
        ${extra}
      </div>`;
    }

    function renderDiscursiva(q, i){
      const linhas = viewMode==='prova'
        ? Array.from({length:6}, ()=> `<div style="border-bottom:1px solid #999;height:22px;"></div>`).join('')
        : `<div style="margin-top:6px;padding:8px 10px;background:#f4f4f4;border:1px solid #ccc;border-radius:4px"><em>Resposta esperada:</em><br>${nl2br(q.discussao)}</div>`;
      return `<div style="margin-bottom:22px">
        <div><strong>${i+1}.</strong> ${nl2br(q.enunciado)}</div>
        ${linhas}
      </div>`;
    }

    let body = '';
    if((p.questoes||[]).length){
      body += `<h3 style="margin:0 0 10px">Parte I — Prova objetiva</h3>`;
      body += p.questoes.map(renderObjetiva).join('');
    }
    if((p.questoesDiscursivas||[]).length){
      body += `<h3 style="margin:18px 0 10px" class="${(p.questoes||[]).length ? 'page-break-before':''}">Parte II — Prova discursiva</h3>`;
      body += p.questoesDiscursivas.map(renderDiscursiva).join('');
    }
    $('#viewProvaConteudo').innerHTML = capa + header + body;
  }

  // ---------- init ----------
  initDb();
})();
</script>
</body>
</html>
