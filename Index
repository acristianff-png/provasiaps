  function confirmDelete(q){
    const modal = `
      <div class="modal-backdrop" id="confirmBackdrop">
        <div class="modal" style="max-width:420px">
          <h2 style="margin-top:0">Excluir questão?</h2>
          <p class="muted" style="margin-bottom:4px">Essa ação não pode ser desfeita.</p>
          <p style="background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;font-size:13.5px">${escapeHtml((q.enunciado||'(sem enunciado)').slice(0,160))}${(q.enunciado||'').length>160?'…':''}</p>
          <div class="row" style="margin-top:14px;justify-content:flex-end">
            <button class="btn secondary" id="cancelDeleteBtn">Cancelar</button>
            <button class="btn danger" id="confirmDeleteBtn" style="background:var(--danger);color:#fff;border-color:var(--danger)">Excluir definitivamente</button>
          </div>
        </div>
      </div>`;
    $('#modalRoot').innerHTML = modal;
    const close = ()=> $('#modalRoot').innerHTML = '';
    $('#confirmBackdrop').addEventListener('click', (e)=>{ if(e.target.id==='confirmBackdrop') close(); });
    $('#cancelDeleteBtn').addEventListener('click', close);
    $('#confirmDeleteBtn').addEventListener('click', async ()=>{
      const { error } = await sb.from('iaps1_questoes').delete().eq('id', q.id);
      if(error){ toast('Erro ao excluir: ' + error.message); return; }
      close(); toast('Questão excluída.'); carregarQuestoes();
    });
  }

  // ---------- alternatives editor ----------
  function altRowHtml(idx, text, correct){
    const letra = String.fromCharCode(97+idx);
    return `<div class="alt-row" data-idx="${idx}">
      <div class="alt-letter">${letra}</div>
      <input type="radio" name="altCorreta" ${correct?'checked':''} style="margin-top:12px" />
      <textarea data-role="altText" placeholder="texto da alternativa ${letra}">${escapeHtml(text||'')}</textarea>
      <button type="button" class="btn danger small" data-role="altRemove" style="margin-top:6px">✕</button>
    </div>`;
  }

  function renderAltList(alts, correctIdx){
    const list = alts && alts.length ? alts : ['',''];
    $('#altList').innerHTML = list.map((a,i)=> altRowHtml(i, a, i===correctIdx)).join('');
    bindAltListEvents();
  }

  function bindAltListEvents(){
    $('#altList').querySelectorAll('[data-role="altRemove"]').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const row = btn.closest('.alt-row');
        if($('#altList').children.length <= 2){ toast('Mínimo de 2 alternativas.'); return; }
        row.remove();
        relabelAltRows();
      });
    });
  }

  function relabelAltRows(){
    Array.from($('#altList').children).forEach((row,i)=>{
      row.dataset.idx = i;
      row.querySelector('.alt-letter').textContent = String.fromCharCode(97+i);
    });
  }

  $('#btnAddAlt').addEventListener('click', ()=>{
