  async function carregarProvas(){
    const { data, error } = await sb.from('iaps1_provas').select('*').order('criadoEm', { ascending: false });
    if(error) return;
    provas = data || [];
    renderProvasTable();
  }

  async function initDb(){
    $('#connStatus').textContent = 'conectado — sincronizando…';
    await carregarQuestoes();
    await carregarProvas();
    // tempo real: qualquer alteração feita por qualquer colaborador atualiza a tela de todos
    sb.channel('iaps1_questoes-rt')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'questoes' }, carregarQuestoes)
      .subscribe();
    sb.channel('iaps1_provas-rt')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'provas' }, carregarProvas)
      .subscribe();
  }

  function renderAll(){
