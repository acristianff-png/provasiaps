  });

  function collectAltData(){
    const rows = Array.from($('#altList').children);
    const alternativas = rows.map(r => r.querySelector('[data-role="altText"]').value.trim());
    let corretaIndex = null;
    rows.forEach((r,i)=>{ if(r.querySelector('input[type=radio]').checked) corretaIndex = i; });
    return {alternativas, corretaIndex};
  }

