  // ---------- stats ----------
  function renderStats(){
    const total = questoes.length;
    const revisar = questoes.filter(q=>q.precisaRevisao).length;
    const semDificuldade = questoes.filter(q=>!q.dificuldade).length;
    const usadas = questoes.filter(q=>q.usadoAnteriormente).length;
    const facil = questoes.filter(q=>q.dificuldade==='facil').length;
    const medio = questoes.filter(q=>q.dificuldade==='medio').length;
    const dificil = questoes.filter(q=>q.dificuldade==='dificil').length;
    $('#statGrid').innerHTML = `
      <div class="stat"><div class="num">${total}</div><div class="lbl">questões no banco</div></div>
      <div class="stat"><div class="num">${facil}</div><div class="lbl">fáceis</div></div>
      <div class="stat"><div class="num">${medio}</div><div class="lbl">médias</div></div>
      <div class="stat"><div class="num">${dificil}</div><div class="lbl">difíceis</div></div>
      <div class="stat"><div class="num">${semDificuldade}</div><div class="lbl">sem dificuldade definida</div></div>
      <div class="stat"><div class="num">${revisar}</div><div class="lbl">precisam revisão</div></div>
