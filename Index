  // ---------- filters ----------
  function uniqueSorted(arr){
    const seen = new Map();
    arr.forEach(v=>{
      if(!v) return;
      const key = v.trim().toLowerCase();
      if(!seen.has(key)) seen.set(key, v.trim());
    });
    return Array.from(seen.values()).sort((a,b)=>a.localeCompare(b,'pt-BR'));
  }

  function renderFilterOptions(){
    const temas = uniqueSorted(questoes.map(q=>q.tema));
    const elaboradores = uniqueSorted(questoes.map(q=>q.elaboradoPor));
    const curTema = $('#fTema').value;
    const curElab = $('#fElaborador').value;
    $('#fTema').innerHTML = '<option value="">Todos</option>' + temas.map(t=>`<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');
    $('#fElaborador').innerHTML = '<option value="">Todos</option>' + elaboradores.map(t=>`<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');
    $('#fTema').value = curTema;
    $('#fElaborador').value = curElab;
    $('#temaOptions').innerHTML = temas.map(t=>`<option value="${escapeHtml(t)}">`).join('');
  }

